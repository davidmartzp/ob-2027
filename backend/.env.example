# Copy to .env and adjust. .env is never committed.
# Production runs on the hosting's Apache + PHP (no Docker); Docker is only the local setup.

# --- Application ---
# local | production
APP_ENV=local
# production: false (no traces in responses)
APP_DEBUG=true
# e.g. /api when the API lives in a subfolder
APP_BASE_PATH=
# Public URL of the API including APP_BASE_PATH (absolute image URLs), e.g. https://origamibogota.com/api
APP_URL=http://localhost:8080
# Public URL of the site
SITE_URL=http://localhost:4200

# Origins allowed to call the API from a browser, comma-separated.
CORS_ORIGINS=http://localhost:4200,http://localhost:4300

# --- Docker ports on your machine (change them if already taken) ---
API_HOST_PORT=8080
DB_HOST_PORT=3307

# --- Database (in Docker, compose.yaml sets DB_HOST and DB_PORT) ---
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=origami
DB_USERNAME=origami
DB_PASSWORD=change-this-password

# --- Email ---
# Production: the hosting's SMTP server, with TLS (the same one angular-ob uses today):
#   MAILER_DSN=smtps://inscripciones%40origamibogota.com:PASSWORD@host51.latinoamericahosting.com:465
# (the @ in the user is written %40).
# Local development: a Mailtrap sandbox inbox (catches every email, nothing is delivered):
#   MAILER_DSN=smtp://USER:PASSWORD@sandbox.smtp.mailtrap.io:2525
MAILER_DSN=null://null
MAIL_FROM_ADDRESS=inscripciones@origamibogota.com
MAIL_FROM_NAME="Origami Bogotá"
MAIL_TEAM_ADDRESS=inscripciones@origamibogota.com
MAIL_SEND_PER_MINUTE=30
# Pause between emails in milliseconds (SMTP servers refuse bursts; 30 × 1 s fits in each cron minute)
MAIL_SEND_INTERVAL_MS=1000

# --- Sessions ---
CMS_TOKEN_HOURS=12

# --- Workshops: allowed levels (P beginner, I intermediate, A advanced) and audiences (A adults, N children) ---
WORKSHOP_LEVELS=P,I,A
WORKSHOP_AUDIENCES=A,N

# --- Participant numbers ---
CODE_MIN_AGE=12
CODE_EXCLUDED_PAYMENT_METHODS="Grupo de apoyo,Invitado,Invitado(a)"

# --- Congress days and turns to pick workshops (Bogotá time) ---
EVENT_SATURDAY=2027-06-05
EVENT_SUNDAY=2027-06-06
TURN_START_TIME=08:00
TURN_END_TIME=19:00
TURN_GROUP_SIZE=25
TURN_MINUTES=10
# true = ignore turns and windows for rehearsals (has no effect with APP_ENV=production)
TURN_BYPASS=false
