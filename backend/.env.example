# Copiar a .env y ajustar. .env nunca se versiona.

# --- Aplicación ---
# local | production
APP_ENV=local
# en producción: false (sin trazas en las respuestas)
APP_DEBUG=true
# p. ej. /api si la API vive en una subcarpeta
APP_BASE_PATH=
# URL pública de la API (para URLs absolutas de imágenes)
APP_URL=http://localhost:8080
# URL del sitio público (enlaces de los correos)
SITIO_URL=http://localhost:4200

# Orígenes que pueden llamar a la API desde el navegador, separados por comas.
CORS_ORIGENES=http://localhost:4200,http://localhost:4300

# --- Puertos de Docker en tu máquina (cámbialos si ya están ocupados) ---
API_PUERTO=8080
DB_PUERTO=3307
CORREO_PUERTO=8025

# --- Base de datos (en Docker, DB_HOST y DB_PORT los pone compose.yaml) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=origami
DB_USERNAME=origami
DB_PASSWORD=cambia-esta-clave

# --- Correo ---
# Producción: SMTP con TLS, p. ej. smtps://usuario:clave@mail.dominio.com:465
# (o smtp://…:587, que negocia STARTTLS). En Docker, compose.yaml lo apunta a Mailpit.
MAILER_DSN=smtp://localhost:1025
CORREO_REMITENTE=inscripciones@origamibogota.com
CORREO_REMITENTE_NOMBRE="Origami Bogotá"
CORREO_EQUIPO=inscripciones@origamibogota.com
CORREO_ENVIOS_POR_MINUTO=30

# --- Sesiones ---
TOKEN_CMS_HORAS=12
TOKEN_ASISTENTE_HORAS=2
ENLACE_ACCESO_MINUTOS=30

# --- Números de participante ---
CODIGOS_EDAD_MINIMA=12
CODIGOS_METODOS_EXCLUIDOS="Grupo de apoyo,Invitado"

# --- Turno de ingreso para elegir talleres (vacío = sin turno) ---
# AAAA-MM-DD HH:MM, hora de Bogotá
TURNO_INICIO=
TURNO_TAMANO_GRUPO=20
TURNO_MINUTOS=10
