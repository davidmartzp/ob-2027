# Only for hostings where the web root cannot point to public/: the whole project is
# uploaded here and these rules expose public/ only.
Options -Indexes -MultiViews

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Any path not already inside public/ is served from public/ (whose .htaccess hands it
    # to index.php). So .env, src/, vendor/, config/, database/, resources/, storage/,
    # bin/ and tests/ are never served.
    RewriteCond %{REQUEST_URI} !/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Fallback in case mod_rewrite is off: deny hidden and configuration files.
<FilesMatch "^\.|\.(env|json|lock|yaml|yml|md|sql|xml|dist)$">
    Require all denied
</FilesMatch>
