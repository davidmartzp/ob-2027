{
    "name": "origami-bogota/backend",
    "description": "Origami Bogotá congress API: Slim 4 + Eloquent on PHP 8.5, hexagonal architecture.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.5",
        "illuminate/database": "^13.38",
        "nesbot/carbon": "^3.15",
        "php-di/php-di": "^7.1",
        "slim/psr7": "^1.8",
        "slim/slim": "^4.15",
        "symfony/mailer": "^8.1",
        "twig/twig": "^3.30",
        "vlucas/phpdotenv": "^5.7"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.5"
        },
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    }
}
