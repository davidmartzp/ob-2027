Options -Indexes -MultiViews

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Some hostings (PHP as CGI/FastCGI) do not pass the Authorization header to PHP.
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Everything goes to the front controller.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# No file in this folder except index.php may run as PHP.
<FilesMatch "\.(php|phtml|phar)$">
    Require all denied
</FilesMatch>
<Files "index.php">
    Require all granted
</Files>
