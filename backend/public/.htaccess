Options -Indexes -MultiViews

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Algunos hostings (PHP como CGI/FastCGI) no pasan el encabezado Authorization a PHP.
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Todo va al controlador frontal.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# Ningún archivo de esta carpeta, salvo index.php, debe ejecutarse como PHP.
<FilesMatch "\.(php|phtml|phar)$">
    Require all denied
</FilesMatch>
<Files "index.php">
    Require all granted
</Files>
