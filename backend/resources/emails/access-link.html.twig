{% extends 'emails/layout.html.twig' %}

{% block title %}Tu enlace para entrar – Congreso de Origami Bogotá{% endblock %}

{% block content %}
<p class="greeting">¡Hola!</p>
<p class="subtitle">
    Pediste entrar al sitio del congreso.
    {% if participants|length > 1 %}Con este correo hay {{ participants|length }} participantes inscritos: cada botón es para uno.{% endif %}
</p>
{% for participant in participants %}
<a href="{{ participant.url }}" class="cta-button">Entrar como {{ participant.name }} →</a><br>
{% endfor %}
<div class="divider"></div>
<div class="note">
    <strong>Cada enlace sirve una sola vez durante {{ minutes }} minutos.</strong> Si no lo pediste, ignora este correo: nadie puede entrar sin él.
</div>
{% endblock %}
